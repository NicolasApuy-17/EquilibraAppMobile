rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userRef(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Only true when the caller's own `users` doc has role == 'admin'. Costs
    // an extra read, only used on the admin-only paths below.
    function isAdmin() {
      return request.auth != null &&
        get(userRef(request.auth.uid)).data.role == 'admin';
    }

    // True when the caller is the psychologist assigned to `patientUid`
    // (i.e. that patient's own `psychologistRef` points back at the caller).
    // Only safe to use for a *single-document* check (a `create`/`update`
    // validation, or a `get` by id) -- seemingly reliable-looking cross-
    // collection `get()` calls like this one turn out to make `list`
    // queries (e.g. a psychologist's own "Registros"/"Avances" tabs
    // querying `records` by `userRef`) silently come back empty instead of
    // erroring, even though every reference matches -- reproduced directly
    // with a patient's real emotional records. For anything read via a
    // list query, denormalize the assigned psychologist onto the document
    // itself instead (see `psychologistRef` on `records`/
    // `behavioral_records`/`tasks` below, and the existing pattern on
    // `sessions`/`activity_assignments`), and compare that field directly.
    function isAssignedPsychologist(patientUid) {
      return request.auth != null &&
        get(userRef(patientUid)).data.psychologistRef == userRef(request.auth.uid);
    }

    // Same check, but takes the patient's reference directly instead of
    // their uid -- required at `create` time on `tasks`/`sessions`/
    // `activity_assignments` below. Extracting `.id` from a reference
    // field on `request.resource.data` (the *proposed* write, as opposed
    // to an already-committed `resource`) throws "Property id is
    // undefined on object" -- confirmed with the Firestore Rules emulator
    // (`request.resource.data.userRef.id` reproduced it exactly). Passing
    // the reference straight to `get()` sidesteps `.id` entirely.
    function isAssignedPsychologistByRef(patientRef) {
      return request.auth != null &&
        get(patientRef).data.psychologistRef == userRef(request.auth.uid);
    }

    // The psychologist currently assigned to the caller (the patient),
    // or null if they don't have one -- a single-document `get()` on the
    // caller's own profile, safe to use even in `create` validation (see
    // the note on `isAssignedPsychologist` above for why this is NOT safe
    // to use as part of a `list` query's read rule).
    function callerPsychologistRef() {
      return get(userRef(request.auth.uid)).data.get('psychologistRef', null);
    }

    // Fields a signed-in user may set on their own `users/{uid}` doc
    // directly from the client (see `maybeCreateUser` / `updateUserProfile`
    // in lib/backend/backend.dart). Everything else on that document --
    // `role`, `psychologistRef`, `psychologistLinkedAt`, `lastActivityAt`,
    // `linkCode`, `specialty` -- is only ever written by Cloud Functions
    // using the Admin SDK, which bypasses these rules entirely.
    function selfManagedUserFields() {
      return ['email', 'display_name', 'photo_url', 'uid', 'phone_number', 'created_time'];
    }

    // `psychologistRef` on a patient-authored document (records,
    // behavioral_records, tasks) is stamped by the *client* at create time,
    // not a Cloud Function -- so `create` must verify it actually matches
    // the caller's own current assignment (`callerPsychologistRef()`, a
    // single-document `get()`, not a list query, so it doesn't have the
    // issue described on `isAssignedPsychologist` above) rather than
    // trusting whatever the client sent. A patient with no psychologist
    // yet must omit the field entirely (`withoutNulls` in the Dart layer
    // does this), which is why this compares against the same
    // `.get(key, null)` default on both sides.
    function patientRecordPsychologistRefIsValid() {
      return request.resource.data.get('psychologistRef', null) == callerPsychologistRef();
    }

    match /records/{document} {
      allow create: if request.auth != null &&
        request.resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid) &&
        patientRecordPsychologistRefIsValid();
      allow read: if request.auth != null &&
        (resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid) ||
         resource.data.get('psychologistRef', null) == userRef(request.auth.uid) ||
         isAdmin());
      allow update: if request.auth != null &&
        (resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid) ||
         (resource.data.get('psychologistRef', null) == userRef(request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['psychologistComment', 'psychologistCommentTime'])));
      allow delete: if request.auth != null &&
        resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    match /behavioral_records/{document} {
      allow create: if request.auth != null &&
        request.resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid) &&
        patientRecordPsychologistRefIsValid();
      allow read: if request.auth != null &&
        (resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid) ||
         resource.data.get('psychologistRef', null) == userRef(request.auth.uid) ||
         isAdmin());
      allow update: if request.auth != null &&
        (resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid) ||
         (resource.data.get('psychologistRef', null) == userRef(request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['psychologistComment', 'psychologistCommentTime'])));
      allow delete: if request.auth != null &&
        resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    match /user_prefs/{document} {
      allow create: if request.auth.uid == document;
      allow read: if request.auth.uid == document;
      allow write: if request.auth.uid == document;
      allow delete: if request.auth.uid == document;
    }

    // A task is either self-created by the patient (`createdByRef ==
    // userRef`) or assigned by their psychologist. `resource.data.get(...)`
    // with a default is used when reading `createdByRef` back because tasks
    // created before this field existed don't have it -- treated as
    // self-created, which is what they actually were. `psychologistRef` is
    // denormalized the same way as on `records` above, for the same reason
    // (list-query reads can't safely use `isAssignedPsychologist`): a
    // self-created task stamps the patient's current psychologist (if any);
    // a psychologist-assigned task stamps the assigning psychologist, which
    // is necessarily the caller themself.
    match /tasks/{document} {
      allow create: if request.auth != null &&
        request.resource.data.createdByRef == /databases/$(database)/documents/users/$(request.auth.uid) &&
        ((request.resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid) &&
          patientRecordPsychologistRefIsValid()) ||
         (isAssignedPsychologistByRef(request.resource.data.userRef) &&
          request.resource.data.psychologistRef == /databases/$(database)/documents/users/$(request.auth.uid)));
      allow read: if request.auth != null &&
        (resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid) ||
         resource.data.get('psychologistRef', null) == userRef(request.auth.uid) ||
         isAdmin());
      allow update: if request.auth != null &&
        ((resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid) &&
          (resource.data.get('createdByRef', resource.data.userRef) == resource.data.userRef
            ? request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['title', 'description', 'dueDate', 'status', 'frequency', 'responseType', 'completedTime', 'patientComment', 'patientCommentAt'])
            : request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'responseText', 'responseValue', 'responseAt', 'completedTime', 'patientComment', 'patientCommentAt']))) ||
         (resource.data.get('psychologistRef', null) == userRef(request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'description', 'dueDate', 'frequency', 'responseType', 'feedback', 'feedbackAt'])));
      allow delete: if request.auth != null &&
        resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid) &&
        resource.data.get('createdByRef', resource.data.userRef) == resource.data.userRef;
    }

    // Clinical session notes: 100% private to the psychologist who wrote
    // them. Neither the patient nor an admin has any read/write path here.
    match /sessions/{document} {
      allow create: if request.auth != null &&
        request.resource.data.psychologistRef == /databases/$(database)/documents/users/$(request.auth.uid) &&
        isAssignedPsychologistByRef(request.resource.data.patientRef);
      allow read, update, delete: if request.auth != null &&
        resource.data.psychologistRef == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // A patient's request to schedule a session with their assigned
    // psychologist -- separate from `sessions` above (private clinical
    // notes written about a session that already happened). The patient
    // picks any date/time for now (no availability validation yet, see
    // schedule_session_widget.dart); the psychologist then confirms or
    // declines it from their "Sesiones" tab. `psychologistRef` is
    // denormalized the same way as on `records`/`behavioral_records`/
    // `tasks` above, for the same reason (list-query reads can't safely use
    // `isAssignedPsychologist`).
    match /session_requests/{document} {
      allow create: if request.auth != null &&
        request.resource.data.patientRef == userRef(request.auth.uid) &&
        patientRecordPsychologistRefIsValid() &&
        request.resource.data.status == 'pendiente';
      allow read: if request.auth != null &&
        (resource.data.patientRef == userRef(request.auth.uid) ||
         resource.data.get('psychologistRef', null) == userRef(request.auth.uid) ||
         isAdmin());
      // The patient may only cancel their own still-pending request; the
      // assigned psychologist may only confirm or decline a pending one.
      allow update: if request.auth != null &&
        ((resource.data.patientRef == userRef(request.auth.uid) &&
          resource.data.status == 'pendiente' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status == 'cancelada') ||
         (resource.data.get('psychologistRef', null) == userRef(request.auth.uid) &&
          resource.data.status == 'pendiente' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'respondedAt', 'psychologistNote']) &&
          (request.resource.data.status == 'confirmada' ||
           request.resource.data.status == 'rechazada')));
      allow delete: if false;
    }

    // One free-text private note per patient, written by their assigned
    // psychologist (document id == patient's uid). Never readable by the
    // patient themself -- deliberately no `request.auth.uid == document`
    // clause here, only `isAssignedPsychologist`.
    match /patient_notes/{document} {
      allow read, write: if isAssignedPsychologist(document);
    }

    // Client-side error/incident log (see lib/utils/error_logging.dart).
    // Any signed-in user's app can write an entry when it hits an unhandled
    // error; only an admin can read the log back, from the admin panel's
    // "Incidencias" tab. Immutable once written -- no update/delete.
    match /app_errors/{document} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    // In-app notifications (chat messages, a psychologist's comments/
    // feedback, task/activity assignment and completion, a new self-service
    // patient-psychologist link, a logged app error) -- see
    // firebase/functions/notifications.js, the only writer. `read` is the
    // one field a client may ever change, to mark a notification seen.
    // The list-query filter and this rule both key on `recipientRef` --
    // deliberately, so `list` reads (the notification feed itself) stay
    // provable: see the note on `isAssignedPsychologist` above for what
    // happens when a rule checks a field the query doesn't also filter on.
    match /notifications/{document} {
      allow read: if request.auth != null &&
        resource.data.recipientRef == userRef(request.auth.uid);
      allow update: if request.auth != null &&
        resource.data.recipientRef == userRef(request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // Admin-managed catalog of tools/activities. Any signed-in user can
    // read it (a patient needs to see the name/description of what was
    // assigned to them; a psychologist needs to browse it to assign from
    // it); only an admin can add/edit/remove entries.
    match /activities/{document} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // One activity assigned to one patient by their psychologist. The
    // assignment's own fields are immutable once created; only the patient
    // may update their progress on it (status/openedAt/completedAt).
    match /activity_assignments/{document} {
      allow create: if request.auth != null &&
        request.resource.data.psychologistRef == /databases/$(database)/documents/users/$(request.auth.uid) &&
        isAssignedPsychologistByRef(request.resource.data.patientRef);
      allow read: if request.auth != null &&
        (resource.data.patientRef == /databases/$(database)/documents/users/$(request.auth.uid) ||
         resource.data.psychologistRef == /databases/$(database)/documents/users/$(request.auth.uid) ||
         isAdmin());
      allow update: if request.auth != null &&
        resource.data.patientRef == /databases/$(database)/documents/users/$(request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'openedAt', 'completedAt']);
      allow delete: if request.auth != null &&
        resource.data.psychologistRef == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    match /goals/{document} {
      allow create: if request.auth != null &&
        request.resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid);
      allow read: if request.auth != null &&
        (resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid) ||
         isAssignedPsychologist(resource.data.userRef.id));
      allow update, delete: if request.auth != null &&
        resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Patient- and psychologist-owned fields on `users` are still only ever
    // written by their owner directly (create/update/delete unchanged) or by
    // Cloud Functions using the Admin SDK, which bypasses these rules
    // entirely (see `createPsychologist` / `linkPsychologistByCode` /
    // `adminAssignPsychologist`). Only `read` gains extra cases: an admin
    // can read any profile, any signed-in user can read a *psychologist's*
    // profile (so a patient can see their linked psychologist's name/photo
    // in chat), and an assigned psychologist can read their own patients'
    // profiles.
    match /users/{document} {
      allow create: if request.auth.uid == document &&
        request.resource.data.keys().hasOnly(selfManagedUserFields());
      // The last clause is a direct field comparison, not
      // `isAssignedPsychologist(document)` -- that helper does a `get()` on
      // `users/{document}` to check this same condition, which here would
      // be a `get()` on the exact document already being evaluated as
      // `resource`. That self-referential lookup made every `list` query a
      // psychologist ran against their own patients (e.g. "Mis
      // consultantes") come back empty, even though the reference values
      // matched perfectly on both ends -- Firestore's rule engine doesn't
      // resolve a self-get() to `resource.data` here. Comparing
      // `resource.data.psychologistRef` directly needs no extra read and
      // has no such issue.
      allow read: if request.auth.uid == document ||
        isAdmin() ||
        resource.data.role == 'psicologo' ||
        resource.data.psychologistRef == userRef(request.auth.uid);
      // A patient may set their own `role` to 'paciente' exactly once,
      // right after sign-up (see create_account_screen_widget.dart) --
      // never to any other value, and never a second time. Every other
      // update may only touch the self-managed profile fields above.
      allow update: if request.auth.uid == document &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(selfManagedUserFields()) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
            !resource.data.keys().hasAny(['role']) &&
            request.resource.data.role == 'paciente'
          )
        );
      allow delete: if request.auth.uid == document;
    }

    // Conversations and their messages are only ever written by the
    // `linkPsychologistByCode` / `adminAssignPsychologist` /
    // `sendConversationMessage` Cloud Functions (Admin SDK, bypasses rules)
    // — clients only ever read here, live, via `.snapshots()`. No
    // create/update/delete rule means direct client writes are denied by
    // default.
    match /conversations/{conversationId} {
      allow read: if request.auth != null &&
        (resource.data.patientRef == /databases/$(database)/documents/users/$(request.auth.uid) ||
         resource.data.psychologistRef == /databases/$(database)/documents/users/$(request.auth.uid));

      // One `get()` on the parent conversation, not two -- reused for both
      // sides of the check instead of fetching the same document twice per
      // message read. This `get()`'s argument is the `conversationId` path
      // segment, constant for the whole query, not `resource.data` -- so,
      // unlike the `psychologistRef` checks elsewhere in this file, it's
      // safe for a `list`/`.snapshots()` query regardless of what the
      // client's own query filters on.
      function isConversationParticipant(conversationId) {
        let conversation =
          get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        return conversation.patientRef == /databases/$(database)/documents/users/$(request.auth.uid) ||
          conversation.psychologistRef == /databases/$(database)/documents/users/$(request.auth.uid);
      }

      match /messages/{messageId} {
        allow read: if request.auth != null && isConversationParticipant(conversationId);
      }
    }
  }
}
